#!/usr/bin/env python3
"""
Script to render multiline Odia text in images with individual realistic effects for VLM training
"""

from PIL import Image, ImageDraw, ImageFont, ImageFilter
import os
import numpy as np
import random

def add_background_texture(img):
    """Add a paper-like texture to the background"""
    width, height = img.size
    texture = Image.new('RGB', (width, height), 'white')
    texture_array = np.array(texture)
    
    # Generate subtle noise
    noise = np.random.normal(0, 5, (height, width, 3)).astype(np.uint8)
    texture_array = np.clip(texture_array + noise, 0, 255)
    
    # Add slight grain
    for _ in range(1000):
        x = random.randint(0, width-1)
        y = random.randint(0, height-1)
        texture_array[y, x] = [random.randint(200, 255)] * 3
    
    texture = Image.fromarray(texture_array)
    return Image.blend(img, texture, 0.1)

def add_printer_drum_defects(img):
    """Simulate printer drum defects with faint lines"""
    draw = ImageDraw.Draw(img)
    width, height = img.size
    
    # Add random faint horizontal/vertical lines
    for _ in range(random.randint(2, 5)):
        if random.choice([True, False]):
            # Horizontal line
            y = random.randint(0, height)
            draw.line((0, y, width, y), fill=(200, 200, 200), width=1)
        else:
            # Vertical line
            x = random.randint(0, width)
            draw.line((x, 0, x, height), fill=(200, 200, 200), width=1)
    
    return img

def add_ink_mottling(img):
    """Add ink mottling effect with uneven ink distribution"""
    width, height = img.size
    mottling = Image.new('L', (width, height), 255)
    mottling_array = np.array(mottling)
    
    # Generate mottling noise
    noise = np.random.normal(0, 10, (height, width)).astype(np.uint8)
    mottling_array = np.clip(mottling_array - noise, 200, 255)
    
    mottling = Image.fromarray(mottling_array, mode='L')
    return Image.composite(img, Image.new('RGB', img.size, 'white'), mottling)

def add_letterpress_impression(img):
    """Simulate letterpress impression with slight embossing"""
    # Apply a subtle blur to simulate ink spread
    img = img.filter(ImageFilter.GaussianBlur(radius=0.5))
    
    # Add slight shadow to text
    img_array = np.array(img)
    shadow = np.zeros_like(img_array)
    shadow[1:, 1:] = img_array[:-1, :-1]
    img_array = np.clip(img_array * 0.95 + shadow * 0.05, 0, 255).astype(np.uint8)
    
    return Image.fromarray(img_array)

def add_lighting_gradient(img):
    """Apply a lighting gradient to simulate uneven illumination"""
    width, height = img.size
    gradient = Image.new('L', (width, height), 255)
    draw = ImageDraw.Draw(gradient)
    
    # Create a radial gradient
    center_x, center_y = width // 2, height // 2
    max_radius = max(width, height)
    for r in range(max_radius):
        intensity = int(255 * (1 - r / max_radius))
        draw.ellipse(
            (center_x - r, center_y - r, center_x + r, center_y + r),
            fill=intensity
        )
    
    gradient = gradient.convert('RGB')
    return Image.blend(img, gradient, 0.2)

def add_line_degradation(img):
    """Simulate line degradation with random breaks in text"""
    img_array = np.array(img)
    height, width, _ = img_array.shape
    
    # Add small random white patches to break lines
    for _ in range(50):
        x = random.randint(0, width-1)
        y = random.randint(0, height-1)
        if np.all(img_array[y, x] < 100):  # Target dark text areas
            size = random.randint(1, 3)
            img_array[max(0, y-size):y+size, max(0, x-size):x+size] = [255, 255, 255]
    
    return Image.fromarray(img_array)

def add_shadow_effects(img):
    """Add subtle shadow effects to text"""
    # Create a blurred shadow
    shadow = img.filter(ImageFilter.GaussianBlur(radius=2))
    shadow_array = np.array(shadow)
    shadow_array = np.clip(shadow_array * 0.8, 0, 255).astype(np.uint8)
    shadow = Image.fromarray(shadow_array)
    
    # Create a mask for the original image
    mask = img.convert('L')
    
    # Create result image
    result = Image.new('RGB', img.size, 'white')
    result.paste(shadow, (2, 2))  # Paste shadow with offset
    result.paste(img, (0, 0), mask)  # Paste original image using its grayscale as mask
    
    return result

def add_ink_bleeding(img):
    """Simulate ink bleeding with slight edge blur"""
    return img.filter(ImageFilter.GaussianBlur(radius=0.3))

def create_base_image_multiline(font, odia_lines):
    """Create base image for multiline Odia text"""
    img_width = 600
    line_height = 60
    img_height = len(odia_lines) * line_height + 40
    
    img = Image.new('RGB', (img_width, img_height), 'white')
    draw = ImageDraw.Draw(img)
    
    y_position = 20
    for line in odia_lines:
        draw.text((20, y_position), line, font=font, fill='black')
        y_position += line_height
    
    return img

def create_base_image_paragraph(font, odia_paragraph):
    """Create base image for paragraph-style Odia text"""
    img = Image.new('RGB', (700, 400), 'white')
    draw = ImageDraw.Draw(img)
    
    draw.multiline_text((30, 30), odia_paragraph, font=font, fill='black', spacing=10)
    
    return img

